# BIẾN MÔI TRƯỜNG DỰ ÁN GALLERY DEVOPS (DTC245200171)
# HÃY COPY FILE NÀY THÀNH .env VÀ ĐỔI CÁC MẬT KHẨU MẶC ĐỊNH
# ==============================================================================

# 1. Cơ sở dữ liệu MySQL
MYSQL_ROOT_PASSWORD=SuperSecureRootPass2026!#
MYSQL_DATABASE=gallery_db
MYSQL_USER=gallery_app_user
MYSQL_PASSWORD=GalleryAppPass2026!#

# 2. Tài khoản dành riêng cho mysqld-exporter (Hardening: Nguyên tắc đặc quyền tối thiểu)
MYSQL_EXPORTER_USER=mysqld_exporter
MYSQL_EXPORTER_PASSWORD=ExporterSecretPass2026!#

# 3. Cấu hình ứng dụng Node.js (Gallery App)
APP_PORT=3000
NODE_ENV=production
SESSION_SECRET=VerySecretSessionKey_ChangeMeInProduction_987654321
UPLOAD_MAX_SIZE_MB=10

# 4. Cấu hình phpMyAdmin
PMA_PORT=8081

# 5. Cấu hình Grafana Dashboard
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=123456
GRAFANA_PORT=3001

# 6. Cấu hình Prometheus
PROMETHEUS_PORT=9090

# 7. Cấu hình Loki & Promtail
LOKI_PORT=3100
