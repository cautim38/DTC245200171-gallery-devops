<%- include('partials/header') %>

<div style="max-width: 1200px; margin: 1.5rem auto;">
  <!-- Share Album Banner -->
  <div class="glass-card" style="padding: 2.5rem; margin-bottom: 2rem; position: relative; overflow: hidden;">
    <div style="position: absolute; top: -20px; right: -20px; font-size: 8rem; opacity: 0.05; pointer-events: none;">
      🔗
    </div>
    
    <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.75rem;">
      <span class="badge-devops" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border-color: rgba(16, 185, 129, 0.3);">
        Album được chia sẻ công khai
      </span>
      <% if (share.category_name) { %>
        <span class="badge-devops">
          <%= share.category_name %>
        </span>
      <% } %>
    </div>

    <h2 style="font-size: 2.2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.5rem;">
      <%= share.album_title %>
    </h2>
    <p style="color: var(--text-muted); font-size: 1.05rem; max-width: 800px; line-height: 1.6;">
      <%= share.album_description || 'Không có mô tả chi tiết.' %>
    </p>

    <div style="margin-top: 1.25rem; font-size: 0.85rem; color: var(--text-muted); display: flex; gap: 1.5rem; flex-wrap: wrap;">
      <span>Tạo bởi: <strong style="color: var(--text-main);"><%= share.owner_name %></strong></span>
      <span>Số lượng ảnh: <strong style="color: var(--accent);"><%= photos.length %> ảnh</strong></span>
      <span>Liên kết chia sẻ bảo mật (Token Verified)</span>
    </div>
  </div>

  <!-- Shared Photos Grid -->
  <% if (photos.length === 0) { %>
    <div class="glass-card" style="text-align: center; padding: 4rem 2rem;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">📷</div>
      <h3 style="font-size: 1.25rem; font-weight: 600;">Album này hiện chưa có ảnh nào</h3>
    </div>
  <% } else { %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem;">
      <% photos.forEach(photo => { %>
        <div class="glass-card" style="overflow: hidden; border-radius: 12px;">
          <a href="/uploads/<%= photo.filename %>" target="_blank" style="display: block; height: 220px; overflow: hidden; background: #000;">
            <img src="/uploads/<%= photo.filename %>" alt="<%= photo.original_name %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease;" onmouseover="this.style.transform='scale(1.06)'" onmouseout="this.style.transform='scale(1)'">
          </a>
          <div style="padding: 0.85rem 1rem; background: rgba(15, 23, 42, 0.7); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 180px;" title="<%= photo.original_name %>">
              <%= photo.original_name %>
            </span>
            <a href="/uploads/<%= photo.filename %>" download="<%= photo.original_name %>" class="btn btn-outline btn-sm" style="font-size: 0.75rem; padding: 0.2rem 0.5rem;" title="Tải ảnh về máy">
              ⬇ Tải về
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
