<%- include('partials/header') %>

<div style="max-width: 460px; margin: 3rem auto;">
  <div class="glass-card" style="padding: 2.5rem 2rem;">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.02em;">Tạo Tài Khoản</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Mật khẩu được mã hóa an toàn bằng thuật toán Bcrypt</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/auth/register" method="POST">
      <div class="form-group">
        <label for="username">Tên người dùng (Username)</label>
        <input type="text" id="username" name="username" class="form-control" placeholder="Tên đăng nhập viết liền không dấu" required autofocus>
      </div>

      <div class="form-group">
        <label for="email">Địa chỉ Email</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="vidu@domain.com" required>
      </div>

      <div class="form-group">
        <label for="password">Mật khẩu (≥ 6 ký tự)</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="Nhập mật khẩu an toàn" required minlength="6">
      </div>

      <div class="form-group">
        <label for="confirmPassword">Xác nhận mật khẩu</label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" required minlength="6">
      </div>

      <div style="margin-top: 1.5rem;">
        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem;">
          Đăng ký tài khoản
        </button>
      </div>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.875rem; color: var(--text-muted);">
      Đã có tài khoản? <a href="/auth/login" style="color: var(--accent); text-decoration: none; font-weight: 600;">Quay lại Đăng nhập</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
